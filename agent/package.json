{
  "name": "mbforge-agent",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "bin": {
    "mbforge": "scripts/cli.mjs"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental --tsBuildInfoFile dist/.tsbuildinfo",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "npm run build && node --test \"dist/*.test.js\"",
    "precli": "npm run build",
    "cli": "node scripts/cli.mjs",
    "link": "npm link",
    "prefetch:bin": "node scripts/prefetch-bin.mjs",
    "dev:cli": "npm run cli"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "typebox": "^1.1.24"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3"
  }
}
