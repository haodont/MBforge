{
  "name": "mbforge-agent",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/*.test.js\"",
    "precli": "npm run build",
    "cli": "pi --offline --no-builtin-tools --theme ./themes --use-theme mbforge-light/mbforge-dark -e ./dist/extension.js",
    "dev:cli": "npm run cli"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "typebox": "^1.1.24"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^6.0.3"
  }
}
